{
  "name": "@dotrino/proxy-client",
  "version": "0.13.0",
  "description": "Cliente WebSocket para el proxy de Dotrino (tokens, canales, firma ECDSA, Web Push)",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./sw": "./sw/dotrino-push-sw.js",
    "./sw/dotrino-push-sw.js": "./sw/dotrino-push-sw.js",
    "./sealing": "./src/sealing.js"
  },
  "files": [
    "src",
    "sw",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "websocket",
    "proxy",
    "dotrino",
    "p2p",
    "signaling"
  ],
  "author": "seyacat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-proxy-client.git"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "@dotrino/identity": ">=0.53.0"
  },
  "peerDependenciesMeta": {
    "@dotrino/identity": {
      "optional": true
    }
  }
}
